{
  "name": "reviews-link-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Customer rating & review-routing platform for restaurants",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "seed": "npm run seed --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client --if-present",
    "start": "npm run start --workspace=server"
  },
  "engines": {
    "node": ">=18"
  }
}
